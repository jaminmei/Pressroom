# Copy this file to .env and replace every REQUIRED placeholder before starting Compose.

APP_NAME="Document Conversion"
FRONTEND_PORT=5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# REQUIRED: use a long random value. Production HTTPS deployments should also
# set AUTH_SESSION_SECURE=true.
AUTH_SESSION_SECRET=replace_with_a_long_random_session_secret
AUTH_SESSION_COOKIE_NAME=docconv_session
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_SAME_SITE=lax
AUTH_SESSION_SECURE=false
AUTH_SESSION_PATH=/

# Built-in engine service URLs.
OCR_ENGINE_URL=http://ocr-engine:8080
VLM_ENGINE_URL=http://vlm-engine:8080
TEXT_ENGINE_URL=http://text-engine:8080
MARKITDOWN_ENGINE_URL=http://markitdown-engine:8080
DOCLING_ENGINE_URL=http://docling-engine:8080
LAYOUT_DETECTION_ENGINE_URL=http://layout-detection-engine:8080
IMAGE_ENHANCEMENT_ENGINE_URL=http://image-enhancement-engine:8080
IMAGE_ROTATION_ENGINE_URL=http://image-rotation-engine:8080
OCR_MOCK_MODE=false
SKIP_DAG_INIT=false

ENGINE_OCR_TIMEOUT=60
ENGINE_OCR_MAX_TIMEOUT=180
ENGINE_VLM_TIMEOUT=120
ENGINE_VLM_MAX_TIMEOUT=300
ENGINE_TEXT_TIMEOUT=30
ENGINE_TEXT_MAX_TIMEOUT=60
ENGINE_MARKITDOWN_TIMEOUT=30
ENGINE_MARKITDOWN_MAX_TIMEOUT=60

# Public workflow input downloads remain public-network-only by default.
INPUT_FETCH_MAX_BYTES=104857600
INPUT_FETCH_TIMEOUT_SECONDS=30
INPUT_FETCH_ALLOW_PRIVATE_HOSTS=false
INPUT_UPLOAD_MAX_BYTES=20971520
INPUT_UPLOAD_RATE_LIMIT_PER_MINUTE=10
API_USAGE_RETENTION_MAX_BYTES_PER_WORKFLOW=52428800

# Provider endpoints may use private/loopback addresses for local engines.
# Link-local, cloud metadata, reserved, multicast, and DNS-rebinding targets
# are always rejected. Set false for internet-only multi-tenant deployments.
PROVIDER_ALLOW_PRIVATE_HOSTS=true

POSTGRES_DB=docconv
POSTGRES_USER=docconv
# REQUIRED: choose a strong password. Compose derives DATABASE_URL from it
# unless an operator explicitly supplies a complete override.
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# REQUIRED for the full queue profile.
REDIS_PASSWORD=replace_with_a_strong_redis_password
# Compose derives these URLs from REDIS_PASSWORD. Uncomment all three only
# when intentionally connecting to an operator-managed Redis deployment.
# REDIS_URL=redis://:<password>@<host>:6379/0
# CELERY_BROKER_URL=redis://:<password>@<host>:6379/0
# CELERY_RESULT_BACKEND=redis://:<password>@<host>:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_QUEUES=celery,workflow,evaluation

# Use serial for the standard profile and queue for the full profile.
ORCHESTRATOR_MODE=serial
ENABLE_QUEUE_MODE=false

# Public distributions always enforce workspace isolation.
WORKSPACE_RBAC_ENFORCED=true
RUNTIME_ATTESTATION_URL=http://backend:8000/api/internal/runtime-attestation
RUNTIME_ATTESTATION_TIMEOUT_SECONDS=5
PROVIDER_DB_PATH=/app/storage/providers.db

# REQUIRED: stable Fernet key shared by backend and worker.
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=replace_with_a_generated_fernet_key
